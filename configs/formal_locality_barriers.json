{
  "schema_version": "formal_locality_barriers_config_v1",
  "title": "Formal Locality-Barrier Certificates for Cross-Netlist Correspondence",
  "baseline_commit": "f480fe107d33132c408ea567b6c561dfb7758440",
  "deterministic_seed": 0,
  "development_heldout_split": {
    "source": "existing active-source/cross-netlist split rows",
    "heldout_tuning": "forbidden"
  },
  "source_signal_universes": [
    {
      "mode": "U0_direct_name_intersection",
      "locality_radius": 0,
